#!/usr/bin/env bash

WM=""

set_wm() {
  if [[ -n "$SWAYSOCK" ]]; then
    WM="sway"
  elif [[ -n "$HYPRLAND_CMD" ]]; then
    WM="Hyprland"
  else
    local error_message="No supported window manager found"
    log error "$error_message"
    fyi "$error_message"
    return 1
  fi
}

pick_option() {
  local PROMPT="Exit $WM?"
  local OPTIONS=$'No\nYes'

  printf "%s" "$OPTIONS" | fuzzel --dmenu --minimal-lines --only-match --mesg "$PROMPT"
}

exit_wm() {
  case "$WM" in
    sway)
      swaymsg exit
      ;;
    Hyprland)
      hyprctl dispatch 'hl.dsp.exit()'
      ;;
  esac
}

main() {
  local option

  set_wm

  option="$(pick_option)"

  if [[ "$option" == "Yes" ]]; then
    exit_wm
  fi
}

main
