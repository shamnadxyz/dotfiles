#!/usr/bin/env python

import json
import logging
import subprocess
from typing import TypedDict

logger = logging.getLogger(__name__)
logging.basicConfig(level=logging.DEBUG)


class Window(TypedDict):
    text: str
    address: str


def run_subprocess(cmd: list[str], input: str | None = None) -> str | None:
    try:
        result = subprocess.run(
            cmd, input=input, text=True, capture_output=True, check=True
        )

        return result.stdout

    except subprocess.CalledProcessError as e:
        logger.error(
            f"{cmd[0]}: exited with a non-zero exit code {e.returncode}"
        )
    except Exception as e:
        logger.error(f"Unexpected error occurred: {type(e).__name__}")

    return None


def pick_item(items: list[str]) -> str | None:
    menu_cmd = [
        "fuzzel",
        "--dmenu",
        "--index",
        "--only-match",
        "--no-run-if-empty",
    ]
    input = "\n".join(items)

    return run_subprocess(menu_cmd, input)


def get_active_windows() -> list[Window] | None:
    get_clients_cmd = ["hyprctl", "clients", "-j"]

    result = run_subprocess(get_clients_cmd)

    if result is None:
        logger.warning("Failed to retrieve clients")
        return None

    clients: list[dict] = json.loads(result)

    workspace_width = max(
        len(client.get("workspace", {}).get("name") or "")
        for client in clients
    )

    windows: list[Window] = []

    for client in clients:
        address = client.get("address")
        c_class = client.get("class")
        title = client.get("title")
        workspace_name: str = client.get("workspace", {}).get("name")

        if address is None or c_class is None:
            continue

        text = (
            f"{workspace_name:>{workspace_width}}  {c_class}"
            if title == c_class or title is None
            else f"{workspace_name:>{workspace_width}}  {c_class} - {title}"
        )

        windows.append({"address": address, "text": text})

    return windows


def focus_window(address: str) -> None:
    hypr_focus_window = [
        "hyprctl",
        "dispatch",
        f"hl.dsp.focus({{ window = 'address:{address}' }})",
    ]

    run_subprocess(hypr_focus_window)


def main() -> None:
    windows = get_active_windows()

    if windows is None:
        return

    entries = [window.get("text") for window in windows if window is not None]
    selection = pick_item(entries)

    if selection is None:
        logger.debug("No window selected")
        return

    index = int(selection.strip())

    address = windows[index].get("address")
    focus_window(address)


if __name__ == "__main__":
    main()
