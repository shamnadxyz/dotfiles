#!/usr/bin/env bash

STATE_DIR="${HOME}/.local/state/wallctl"
WALLPAPER="${STATE_DIR}/wallpaper"
WALLPAPERS_DIR="${WALLPAPERS:-${HOME}/Pictures/Wallpapers}"

generate_colors=0
persist=1

print_help() {
  echo "Usage: wallctl set <filepath> | pick [<directory>] | restore

Options:
  --generate-colors, -g        Generate color scheme using wallust
  --once, -n                   Set wallpaper for just this instance
  --help, -h                   Print help
"
}

show_hint() {
  local nid
  nid="$(fyi --print-id "$@")"
  printf '%s' "${nid#*=}"
}

close_notification() { fyi --close="$1"; }

save_wallpaper() {
  local image wallpaper image_path current_wallpaper

  image="$1"

  if [[ -z "$image" ]]; then
    log error "save_wallpaper: missing required argument"
    return 1
  fi

  if [[ ! -f "$image" ]]; then
    log error "save_wallpaper: $image: No such file"
    return 1
  fi

  current_wallpaper="$(readlink "$WALLPAPER")"
  image_path="$(realpath "$image")"

  if [[ "$image_path" == "$current_wallpaper" ]]; then
    log info "save_wallapper: selected current wallpaper"
  fi

  ln -sf "$image_path" "$WALLPAPER"
}

apply_wallpaper() {
  local image="$1"
  pkill swaybg
  swaybg --mode fill --image "$image" &
  disown
}

set_wallpaper() {
  image="$1"
  if [[ "$persist" == 1 ]]; then
    save_wallpaper "$image"
  fi

  apply_wallpaper "$image"
}

pick_wallpaper() {
  local directory
  directory="${1:-$WALLPAPERS_DIR}"
  local pick_config="${HOME}/.config/swayimg/pick.lua"

  if [[ ! -f "$pick_config" ]]; then
    log error "pick_wallpaper: '$pick_config' swayimg pick config not found"
    return 1
  fi

  local id
  id="$(show_hint "Wallpaper Selector" "Select: 'Shift+Return'")"
  local image
  image="$(swayimg --gallery --config "$pick_config" "$directory")"
  close_notification "$id"

  if [[ -z "$image" ]]; then
    log debug "pick_wallpaper: no image selected"
    return 1
  fi

  set_wallpaper "$image"
}

main() {
  readarray -t missing_commands < <(check_cmd "swaybg" "swayimg" "log" "fyi" "wallust")
  if [[ "${#missing_commands[@]}" -gt 0 ]]; then
    fyi "Missing commands" "${missing_commands[*]}"
    return 1
  fi

  mkdir -p "$STATE_DIR"
  local image

  if [[ $# -eq 0 ]]; then
    print_help >&2
    exit 1
  fi

  local selected_command
  local command_argument

  while [[ $# -ne 0 ]]; do
    case "$1" in
      restore)
        selected_command=restore
        shift
        ;;
      set)
        selected_command=set
        if [[ $# -lt 2 ]]; then
          log error "Missing required argument: filepath"
          print_help >&2
          return 1
        fi
        command_argument="$2"
        shift 2
        ;;
      pick)
        selected_command=pick
        if [[ $# -lt 2 ]]; then
          shift 1
        elif [[ "$2" =~ ^(-|--)[a-zA-Z]+$ ]]; then
          shift 1
        else
          command_argument="$2"
          shift 2
        fi
        ;;
      --once | -n)
        persist=0
        shift 1
        ;;
      --generate-colors | -g)
        generate_colors=1
        shift 1
        ;;
      --help | -h)
        print_help
        exit 0
        ;;
      *)
        log error "wallctl: invalid option: '$1'"
        print_help >&2
        exit 1
        ;;
    esac
  done

  case "$selected_command" in
    set) set_wallpaper "$command_argument" ;;
    pick) pick_wallpaper "$command_argument" ;;
    restore) apply_wallpaper "$WALLPAPER" ;;
  esac

  [[ "$generate_colors" -eq 1 ]] && wallust run "$WALLPAPER" && pkill --exact -SIGUSR2 waybar
}

main "$@"
