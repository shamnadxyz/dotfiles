#!/usr/bin/env bash
# DEPENDENCIES: fyi wbg swayimg wallust

readonly wallpaper_path="$HOME/.cache/wallpaper"
WALLPAPERS="${WALLPAPERS:-$HOME/Pictures/Wallpapers}"
GENERATE_COLORSCHEME="${GENERATE_COLORSCHEME:-0}"

log_err() {
  printf 'setwall: %s\n' "$*" >&2
}

reload_waybar() { pkill -SIGUSR2 waybar; }

generate_colorscheme() {
  if ! wallust run "$wallpaper_path" -q; then
    log_err "Failed to generate the colorscheme"
    return 1
  fi

  reload_waybar
}

set_wallpaper() {
  local wallpaper absolute_path
  wallpaper="$1"

  if [[ ! -f "$wallpaper" ]]; then
    log_err "$wallpaper: No such file"
    return 1
  fi

  absolute_path="$(realpath "$wallpaper")"
  ln -sf "$absolute_path" "$wallpaper_path"

  pkill --exact wbg
  wbg --stretch "$wallpaper_path" &>/dev/null &
  disown
}

show_hint() {
  local nid
  nid="$(fyi --print-id "Wallpaper Selector" "Press 'Shift+Return' to select")"
  printf '%s' "${nid#*=}"
}

close_hint() { fyi --close="$1"; }

pick_wallpaper() {
  local wallpaper hint_id

  if [[ ! -d "$WALLPAPERS" ]]; then
    log_err "'$WALLPAPERS': No such directory"
    exit 1
  fi

  hint_id="$(show_hint)"
  wallpaper="$(swayimg -g "$WALLPAPERS" --config ~/.config/swayimg/pick.lua)"
  close_hint "$hint_id"

  [[ -z "$wallpaper" ]] && exit 1
  printf '%s' "$wallpaper"
}

main() {
  local wallpaper

  if [[ -f "$1" ]]; then
    wallpaper="$1"
  elif [[ -d "$1" ]]; then
    WALLPAPERS="$1"
  elif [[ ! -z "$1" ]]; then
    log_err "'$1' No such file or directory"
    return 1
  fi

  if [[ -z "$wallpaper" ]]; then
    wallpaper="$(pick_wallpaper)"
  fi

  if set_wallpaper "$wallpaper"; then
    [[ "$GENERATE_COLORSCHEME" -eq 1 ]] && generate_colorscheme
  fi
}

main "$@"
