{
  "position": "top",
  "ipc": false,
  "modifier": "Mod4",
  "reload_style_on_change": true,
  "mod": "dock",
  "exclusive": true,
  "passthrough": false,
  "gtk-layer-shell": true,
  "spacing": 0,
  "margin-top": 4,
  "margin-left": 4,
  "margin-right": 4,
  "margin-bottom": 0,
  "modules-left": [
    "custom/distro",
    "mpd"
  ],
  "modules-center": [
    "clock"
  ],
  "modules-right": [
    "tray",
    "idle_inhibitor",
    "memory",
    "cpu",
    "temperature",
    "network",
    "bluetooth",
    "pulseaudio#sink",
    "pulseaudio#source",
    "backlight",
    "battery",
    "privacy",
    "custom/power"
  ],
  "clock": {
    "interval": 60,
    "format": "{:%I:%M %p}",
    "format-alt": "{:%b %d  %I:%M %p}",
    "tooltip-format": "{calendar}",
    "calendar": {
      "mode": "month",
      "mode-mon-col": 3,
      "on-scroll": 1,
      "format": {
        "months": "<span color='#DBE3F1'>{}</span>",
        "days": "<span color='#DBE3F1' weight='normal'>{}</span>",
        "weekdays": "<span color='#A1D6FD'>{}</span>",
        "today": "<span color='#B0DDB0' weight='bold'>{}</span>"
      }
    },
    "actions": {
      "on-click-right": "mode",
      "on-click-forward": "tz_up",
      "on-click-backward": "tz_down",
      "on-scroll-up": "shift_up",
      "on-scroll-down": "shift_down"
    }
  },
  "idle_inhibitor": {
    "format": "{icon}",
    "format-icons": {
      "activated": " ",
      "deactivated": " "
    }
  },
  "network": {
    "format": "󰛳 ",
    "format-wifi": " ",
    "format-ethernet": " ",
    "format-disconnected": "󰲛 ",
    "tooltip-format": "{ifname} via {gwaddr}",
    "tooltip-format-wifi": "{essid} ({signalStrength}%) {ifname}\n{ipaddr} via {gwaddr}",
    "tooltip-format-ethernet": "{ipaddr}/{cidr} {ifname}",
    "tooltip-format-disconnected": "Disconnected",
    "max-length": 25
  },
  "bluetooth": {
    "format": "󰂲",
    "format-disabled": "󰂲",
    "format-connected": "󰂯",
    "tooltip-format": "{controller_alias}\t{controller_address}\n\n{num_connections} connected",
    "tooltip-format-connected": "{num_connections} connected\n\n{device_enumerate}",
    "tooltip-format-enumerate-connected": "{device_alias}",
    "tooltip-format-enumerate-connected-battery": "{device_alias}\t{device_battery_percentage}%",
    "on-click": "foot -a bluetui -T bluetui bluetui",
    "max-length": 20
  },
  "tray": {
    "icon-size": 18
  },
  "battery": {
    "format": "{icon} {capacity}",
    "format-icons": {
      "not-charging": "",
      "plugged": "",
      "charging": [
        "󰢜",
        "󰂆",
        "󰂇",
        "󰂈",
        "󰢝",
        "󰂉",
        "󰢞",
        "󰂊",
        "󰂋",
        "󰂅"
      ],
      "default": [
        "󰁺",
        "󰁻",
        "󰁼",
        "󰁽",
        "󰁾",
        "󰁿",
        "󰂀",
        "󰂁",
        "󰂂",
        "󰁹"
      ]
    },
    "interval": 60,
    "states": {
      "warning": 30,
      "critical": 20
    },
    "tooltip-format": "<b>Battery Info</b>\nPower Draw: {power}W\n{timeTo}\nBattery Health: {health}%",
    "tooltip-format-charging": "<b>Battery Info</b>\nPower: {power}W\n{timeTo}\nBattery Health: {health}%"
  },
  "backlight": {
    "device": "intel_backlight",
    "format": "{icon} {percent}%",
    "format-icons": [
      "",
      "",
      "",
      "",
      "",
      "",
      "",
      "",
      ""
    ],
    "reverse-scrolling": true,
    "on-scroll-up": "brightnessctl s 1%+",
    "on-scroll-down": "brightnessctl s 1%- --min-value=4800",
    "tooltip": false
  },
  "cpu": {
    "interval": 10,
    "format": "  {usage}%"
  },
  "memory": {
    "interval": 30,
    "format": "  {used:0.1f}G",
    "tooltip-format": "Memory: {used}G / {total}G ({percentage}%)\nAvailable: {avail}G\nSwap: {swapUsed}G / {swapTotal}G ({swapPercentage}%)"
  },
  "temperature": {
    "thermal-zone": 1,
    "format": "{icon} {temperatureC}°C",
    "format-icons": [
      "",
      "",
      ""
    ],
  },
  "custom/power": {
    "format": "",
    "tooltip": false,
    "menu": "on-click",
    "menu-file": "$HOME/.config/waybar/power_menu.xml",
    "menu-actions": {
      "poweroff": "poweroff",
      "reboot": "reboot",
      "suspend": "systemctl suspend",
      "hibernate": "systemctl hibernate"
    }
  },
  "privacy": {
    "icon-spacing": 0,
    "icon-size": 10,
    "transition-duration": 250,
    "modules": [
      {
        "type": "screenshare",
        "tooltip": true,
        "tooltip-icon-size": 10
      },
      {
        "type": "audio-in",
        "tooltip": true,
        "tooltip-icon-size": 10
      }
    ]
  },
  "pulseaudio#sink": {
    "format": "{icon} {volume}",
    "format-muted": " ",
    "on-click": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
    "reverse-scrolling": true,
    "format-icons": {
      "headphone": " ",
      "headset": " ",
      "default": [
        " ",
        " ",
        " "
      ]
    }
  },
  "pulseaudio#source": {
    "format": "{format_source}",
    "format-source": " {volume}",
    "format-source-muted": " ",
    "on-click": "wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle",
    "on-scroll-up": "wpctl set-volume -l 1 @DEFAULT_AUDIO_SOURCE@ 1%+",
    "on-scroll-down": "wpctl set-volume @DEFAULT_AUDIO_SOURCE@ 1%-",
    "reverse-scrolling": true
  },
  "mpd": {
    "format": " {stateIcon} {title} ",
    "format-disconnected": " Disconnected ",
    "format-stopped": "",
    "interval": 10,
    "state-icons": {
      "paused": "",
      "playing": ""
    },
    "on-click": "rmpc togglepause",
    "on-scroll-up": "rmpc volume +5",
    "on-scroll-down": "rmpc volume -5",
    "reverse-scrolling": true,
    "tooltip-format": "Title: {title}\nArtist: {artist}\nAlbum: {album}\nVolume: {volume}%\nQueue: {songPosition}/{queueLength}\n{elapsedTime:%M:%S}/{totalTime:%M:%S}",
    "menu": "on-click-right",
    "menu-file": "$HOME/.config/waybar/mediaplayer.xml",
    "menu-actions": {
      "play-pause": "rmpc togglepause",
      "next": "rmpc next",
      "previous": "rmpc prev"
    }
  },
  "custom/distro": {
    "format": "{}",
    "tooltip": true,
    "exec": "distro-icon",
    "interval": "once",
    "tooltip-format": "Open window switcher",
    "on-click": "rofi -show window"
  }
}
